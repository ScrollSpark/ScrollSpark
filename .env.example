# Optional: Gmail App Password for Supabase Auth SMTP when using uncommented
# [auth.email.smtp] in supabase/config.toml (local `supabase start` only).
# Hosted projects: set SMTP in Supabase Dashboard → Authentication → SMTP instead.
# SUPABASE_AUTH_SMTP_PASS=

# RevenueCat (App Store / Google Play subscriptions) — public SDK keys only.
# Get these from https://app.revenuecat.com → your app → API keys
VITE_REVENUECAT_APPLE_API_KEY=
VITE_REVENUECAT_GOOGLE_API_KEY=

# Must match the entitlement identifier in RevenueCat (e.g. ScrollSpark Pro)
VITE_REVENUECAT_ENTITLEMENT_ID="ScrollSpark Pro"
